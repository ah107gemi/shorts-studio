# ============================================================
# Shorts Studio — Environment Configuration Example
# Copy this file to .env and fill in your keys if desired.
# All external AI providers are OPTIONAL. The studio works
# 100% locally with procedural visuals and local voiceover synthesis.
# ============================================================

# App Configuration
APP_NAME="Shorts Studio"
LOG_LEVEL=INFO

# AI Scriptwriting & Storyboard (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Voiceover Synthesis (Optional - Falls back to local Windows SAPI synthesizer)
ELEVENLABS_API_KEY=
TTS_PROVIDER=none

# Visual & Media Sourcing (Optional - Falls back to procedural title cards & imported media)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Video Assembly Pipeline Defaults
DEFAULT_RESOLUTION_W=1080
DEFAULT_RESOLUTION_H=1920
DEFAULT_FPS=30
MAX_CONCURRENT_RENDERS=1

# Custom FFmpeg Path (Leave empty to use the bundled portable binary in bin/ffmpeg.exe)
FFMPEG_PATH=
